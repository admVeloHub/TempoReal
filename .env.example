# Frontend — copie para .env.local (gitignore; não commitar)
# VERSION: v1.0.3

PORT=5000

# npm start: o painel (Pix tempo real, stats, etc.) usa por defeito http://localhost:5050.
# Não defina REACT_APP_API_URL para Cloud Run só para “testar” — o dashboard chamaria a API antiga.
# Opcional: outra base local (ex.: outra porta)
# REACT_APP_API_URL_LOCAL=http://localhost:5050

# --- Só se quiser UI local falando com API Cloud Run (ex.: /hook contra prod) ---
# REACT_APP_USE_PRODUCTION_API=1
# REACT_APP_API_URL=https://temporeal-278491073220.us-east1.run.app
# Webhook Octadesk (referência): .../api/integrations/octadesk/webhook
