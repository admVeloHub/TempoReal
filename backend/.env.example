PORT=5050
# String de conexão MongoDB (Cloud Run Secret / local): variável MONGO_ENV
MONGO_ENV=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Webhook Octadesk: mesmo valor que a Octadesk envia na requisição. Aceito em:
# x-webhook-secret, x-octadesk-webhook-secret, Authorization: Bearer <valor>, ou x-api-key (como na API /auth/check)
OCTADESK_WEBHOOK_SECRET=
