PORT=5050
# String de conexão MongoDB (Cloud Run Secret / local): variável MONGO_ENV
MONGO_ENV=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Webhook Octadesk N1 (recomendado): mesmo valor em OCTADESK_WEBHOOK_SECRET e na URL do painel Octadesk, ex.:
# https://seu-host/api/integrations/octadesk/webhook?octadesk_webhook_key=MESMO_VALOR_AQUI
# Alternativa: header x-api-key ou x-octadesk-webhook-secret (se a plataforma permitir).
# Se vazio: webhook fica público (só uso em dev ou URL não divulgada).
# OCTADESK_WEBHOOK_SECRET=defina_um_segredo_longo_aleatorio

# Terminal: acompanhar hub_ouvidoria.octadesk_ingest_log em tempo quase real (mesmo MONGO_ENV que Cloud Run → vê entregas enquanto roda npm start local). Evite em Cloud Run prod (polui log).
# OCTADESK_INGEST_TAIL_CONSOLE=1
# OCTADESK_INGEST_TAIL_MS=2500
# OCTADESK_INGEST_TAIL_BOOT_LAST=5

# Rótulo gravado em octadesk_ingest_log.processedBy (coluna Instância no /hook). Útil para distinguir laptop vs Cloud Run no mesmo Mongo.
# OCTADESK_INGEST_PROCESSOR_TAG=dev-laptop
# URL de exemplo (configurar no painel Octadesk):
# POST https://temporeal-278491073220.us-east1.run.app/api/integrations/octadesk/webhook
# Para testar /hook no navegador local com dados reais: mantenha o webhook na URL de prod
# e no front use REACT_APP_API_URL apontando para esse mesmo host (veja .env.example na raiz).
